# ---------------------------------------------------------------------------
# SolarSync backend configuration
# Copy to `.env` and fill in whatever you have. EVERY KEY IS OPTIONAL.
# With an empty .env the system runs 100% in "Demo Fallback" mode using real
# OpenStreetMap building footprints + a physically-grounded Malaysia solar /
# rooftop-obstacle simulator, so the whole product is demoable out of the box.
# ---------------------------------------------------------------------------

# Google Solar API key (Building Insights only - no Maps Static needed, imagery
# comes from Esri World Imagery which is keyless).
# Enables: real Google Solar roof segments and real API coverage filtering
# (404 -> UNRANKED_NO_DATA).
GOOGLE_MAPS_API_KEY=

# Gemini vision (Google AI Studio key). Detects rooftop obstacles on the
# satellite mosaic. Leave empty to fall back to the geometric obstacle simulator.
GEMINI_API_KEY=
# Optional: several keys from different Google projects, comma separated. Free
# quota is per project, so N keys ~ N x requests-per-minute.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
VISION_PROVIDER=gemini

# Legacy: Inkling (Thinking Machines) / OpenRouter vision endpoint.
INKLING_API_KEY=
INKLING_API_URL=
INKLING_MODEL=inkling-vision

# Overpass API endpoints (OSM building footprints). Comma separated, the
# adapter fails over between them.
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.osm.ch/api/interpreter

# SQLite database file (relative to backend/)
DATABASE_URL=sqlite:///./solarsync.db

# Runtime
APP_NAME=SolarSync
ALGORITHM_VERSION=1.0.0
MODEL_VERSION=1.0.0
SCORING_VERSION=1.0.0
SOURCE_POLICY_VERSION=1.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Maximum concurrent building analyses inside a single city batch job.
MAX_CONCURRENT_BUILDINGS=5
# Hard cap on buildings ingested per AREA run (keeps a hackathon demo snappy).
MAX_BUILDINGS_PER_RUN=150

# Screening policy: skip roofs tagged residential in OSM (house/apartments/terrace).
# Set to false to rank every building again.
EXCLUDE_RESIDENTIAL=true
# Geometric floor in m2. Raise to ~150 to also drop generic `building=yes` houses.
MIN_FOOTPRINT_M2=12

# Tunables for the Malaysia model (see backend/app/config.py)
SOLAR_BASELINE_KWH_PER_KWP_YEAR=1450
GRID_EMISSION_FACTOR_KG_CO2_PER_KWH=0.758
ELECTRICITY_TARIFF_RM_PER_KWH=0.50
SYSTEM_EFFICIENCY_AC=0.82
